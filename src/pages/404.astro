---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Radixa Technologies" description="The page you were looking for could not be found." noindex>
  <section>
    <div class="wrap">
      <div class="narrow">
        <p class="eyebrow">404</p>
        <h1>We could not find that page.</h1>
        <p class="lede mt-s">
          The link may be out of date, or the page may have moved. Here is where most people are
          heading.
        </p>
        <div class="btn-group mt-m">
          <a class="btn btn-primary" href="/">Go to the homepage</a>
          <a class="btn btn-secondary" href="/services/">See what we do</a>
        </div>
        <ul class="checklist mt-l">
          <li><a href="/services/sap-group-reporting/">SAP S/4HANA Group Reporting</a></li>
          <li><a href="/services/bpc-modernisation-assessment/">BPC Modernisation &amp; Platform Assessment</a></li>
          <li><a href="/contact/">Contact Radixa</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
