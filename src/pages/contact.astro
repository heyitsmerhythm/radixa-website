---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../config';
---

<Base
  title="Contact Radixa Technologies"
  description="Tell us what you are trying to solve — BPC replacement, Group Reporting design, SAC, or a finance reporting architecture review."
>
  <Hero
    eyebrow="Contact"
    title="Tell Us What You Are Trying to Solve."
    lede="Whether you are replacing BPC, designing Group Reporting, improving SAC or reviewing a finance reporting architecture, share the problem and we will start with the right conversation."
  />

  <section style="padding-top:0">
    <div class="wrap">
      <div class="grid" style="grid-template-columns:1fr;gap:56px">
        <div style="display:grid;gap:56px" class="contact-grid">
          <div>
            <EnquiryForm variant="general" />
          </div>

          <aside style="min-width:0">
            <div class="card" style="background:var(--grey-50)">
              <h3>Prefer email?</h3>
              <p>
                Write to us directly at
                <a href={`mailto:${site.email}`}>{site.email}</a>. We read every enquiry ourselves.
              </p>
            </div>

            <div class="card mt-s">
              <h3>What happens next</h3>
              <ul class="checklist" style="margin-top:8px">
                <li>We read your enquiry and reply by email, usually within one working day.</li>
                <li>If it is something we can help with, we propose a short call to understand the context properly.</li>
                <li>If it is outside our scope, we will say so — and point you elsewhere where we can.</li>
              </ul>
            </div>

            <div class="card mt-s">
              <h3>Replacing SAP BPC?</h3>
              <p>
                There is a dedicated enquiry form with the questions we would ask anyway — landscape,
                use cases and decision timeline.
              </p>
              <a class="link-arrow" href="/services/bpc-modernisation-assessment/#enquiry">
                Request a BPC assessment
              </a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (min-width: 1000px) {
    .contact-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 64px !important;
      align-items: start;
    }
  }
</style>
