---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTABand from '../../components/CTABand.astro';

const CAP = '/contact/?capability=SAP%20Analytics%20Cloud';

/* ---------------------------------------------------------------------------
   What finance uses SAC for — grouped by use case rather than by feature
--------------------------------------------------------------------------- */
const useCases = [
  {
    t: 'Budgeting and forecasting',
    b: 'Annual budget, rolling forecast and long-range plan running as one connected process rather than three disconnected exercises — with seeding, submission, workflow and locking designed rather than improvised.',
  },
  {
    t: 'Driver-based and scenario planning',
    b: 'Volume and price, headcount and cost, capacity and spend. Enough drivers that the plan explains the business, and not so many that the model becomes harder to explain than the thing it models.',
  },
  {
    t: 'Integrated financial planning',
    b: 'Profit and loss, balance sheet and cash flow in one model, so a change in revenue assumptions moves working capital and cash without anyone rebuilding a spreadsheet bridge.',
  },
  {
    t: 'Allocations and cost planning',
    b: 'Structured allocation logic a finance user can trace a number back through — including the decision about whether that logic belongs in SAC at all.',
  },
  {
    t: 'Management reporting and variance analysis',
    b: 'Actual, budget and forecast in one analytical framework, with one agreed definition per KPI, rather than three exports reconciled by hand each month.',
  },
  {
    t: 'Board and executive reporting',
    b: 'Reporting weighted by financial materiality, with variance that reads at a glance and drill-down only where it answers a real follow-up question.',
  },
];

/* ---------------------------------------------------------------------------
   Where SAC fits in the finance architecture
--------------------------------------------------------------------------- */
const architecture = [
  {
    q: 'Live connection or imported data?',
    a: 'Less a spectrum than a fork: planning in a public model requires imported data, while a live connection preserves a single source of truth and rules most modelling and planning out. The choice should follow from latency, security, transformation and planning requirements — not from a blanket preference.',
  },
  {
    q: 'Where should finance logic live?',
    a: 'Calculations split across S/4HANA, Datasphere, BW and SAC stories are how definitions drift apart. We decide which layer owns which logic, and hold that line through delivery.',
  },
  {
    q: 'How do actuals, budget and forecast meet?',
    a: 'Integration between ACDOCA, ACDOCP, Group Reporting results and planning models, so actual-versus-budget-versus-forecast is structural rather than assembled by hand each month.',
  },
  {
    q: 'Which platforms are actually required?',
    a: 'SAC, Datasphere, BW/4HANA and Business Data Cloud overlap. Not every organisation needs all of them, and deciding deliberately is cheaper than discovering the answer during the build.',
  },
];

/* ---------------------------------------------------------------------------
   Planning edge cases (§6.1)
--------------------------------------------------------------------------- */
const edgeCases = [
  {
    t: 'Multiple currencies and planning rates',
    b: 'Local, transaction and group currency each need a stated purpose, planning rates need an owner, and rates have to stay consistent across versions — or every comparison becomes an argument.',
  },
  {
    t: 'Mixed granularity',
    b: 'Revenue by product, workforce by position, CAPEX by project and the financial statements by account. Forcing all four to one grain is the most common cause of a model nobody wants to use.',
  },
  {
    t: 'Actuals that arrive late, or restate',
    b: 'Seeding, cutover periods, forecast refresh and version governance. A model that assumes actuals are final will break the first time they are not.',
  },
  {
    t: 'Top-down targets and bottom-up submission',
    b: 'Usually both at once. The design has to support target setting while preserving accountable operational input, and reconcile the two without one silently overwriting the other.',
  },
  {
    t: 'Cross-model dependencies',
    b: 'When separate models should genuinely interact, and when connecting them only creates a fragile dependency that fails at the worst point in the cycle.',
  },
  {
    t: 'Allocations at scale',
    b: 'Transparency, runtime and traceability degrade together. Past a certain volume the question stops being how to write the allocation and becomes which layer should run it.',
  },
  {
    t: 'Large dimensionality and sparsity',
    b: 'Model grain and performance are the same decision viewed from two directions. Far cheaper to settle at design than to discover during user testing.',
  },
  {
    t: 'Security by entity, cost centre and version',
    b: 'Data access, planning ownership and workflow are one design problem. Treating security as a configuration task at the end reliably produces a model people cannot use.',
  },
  {
    t: 'Excel-heavy finance users',
    b: 'Some contributors will never plan in a browser, and pretending otherwise costs adoption. Microsoft Office integration can carry input and write-back where that is the honest answer.',
  },
  {
    t: 'Group Reporting actuals with SAC plan',
    b: 'Aligning actual, plan and forecast across two platforms means agreeing hierarchies, grain and reporting ownership up front — not reconciling them afterwards.',
  },
];

const modelDesign = [
  'Model granularity and data volumes',
  'Dimensions, measures, accounts and time',
  'Version and category strategy',
  'Currency and organisational structures',
  'Planning levels and disaggregation',
  'Calculation, data action and multi-action design',
  'Master data and hierarchy ownership',
  'Security and workflow, designed in rather than bolted on',
];

/* ---------------------------------------------------------------------------
   Engagements (§6.1)
--------------------------------------------------------------------------- */
const engagements = [
  {
    name: 'SAC Planning Assessment',
    duration: '2–4 weeks',
    deliverables: 'Current-state review, requirements, fit assessment, target process and architecture, roadmap',
    href: '/services/sac-planning-assessment/',
  },
  {
    name: 'SAC Planning Solution Design',
    duration: '3–8 weeks',
    deliverables: 'Blueprint, model architecture, driver/version/currency design, workflow, integration, reporting and test approach',
    href: null,
  },
  {
    name: 'SAC Reporting Design',
    duration: '2–6 weeks',
    deliverables: 'Reporting requirements, KPI model, data sourcing, story and dashboard design system, governance',
    href: null,
  },
  {
    name: 'SAC Health Check',
    duration: '1–3 weeks',
    deliverables: 'Architecture, model and performance review, findings, quick wins and a remediation roadmap',
    href: '/services/sac-health-check/',
  },
];

/* ---------------------------------------------------------------------------
   BPC → SAC
--------------------------------------------------------------------------- */
const bpcMapping = [
  ['Budgeting', 'SAC Planning'],
  ['Rolling forecast', 'SAC Planning'],
  ['Driver-based planning', 'SAC Planning'],
  ['Management reporting', 'SAC'],
  ['Legal consolidation', 'SAP Group Reporting or an alternative platform'],
  ['Management consolidation', 'Group Reporting, SAC or an alternative, depending on requirements'],
  ['Allocations', 'SAC, Group Reporting or the source system, depending on use case'],
  ['Data collection', 'SAC, Group Reporting Data Collection or the integration layer'],
  ['Excel input', 'SAC Microsoft Office integration where appropriate'],
  ['Executive dashboards', 'SAC'],
  ['Workflow', 'SAC planning process design'],
];

const challenges = [
  'Our planning process is still heavily spreadsheet-driven.',
  'We have SAC, but finance adoption is low.',
  'Our SAC models have become slow and difficult to maintain.',
  'We want to move planning out of BPC but do not know whether SAC supports our requirements.',
  'We have Group Reporting but do not know how SAC should fit into the reporting architecture.',
  'Management reporting takes too much manual effort every month.',
  'Different teams have different versions of the same KPI.',
  'Our SAC implementation reproduced our old processes rather than improving them.',
];

const approach = [
  {
    title: 'Finance first',
    body: 'We start with the decisions, processes and reporting finance needs to support — not with the platform.',
  },
  {
    title: 'Architecture before build',
    body: 'Where data, calculations, planning logic and reporting live is settled before models and dashboards are built.',
  },
  {
    title: 'Simplify before migrating',
    body: 'Legacy processes get challenged before they are reproduced. Not everything in the old system deserves to survive.',
  },
  {
    title: 'Design for ownership',
    body: 'Your team should be able to understand and operate the solution after we leave. That constrains how clever the design is allowed to be.',
  },
  {
    title: 'Reporting with purpose',
    body: 'Every dashboard, table and visual should answer a business question someone is actually asking.',
  },
  {
    title: 'Integrate where it adds value',
    body: 'Planning, consolidation and reporting connect where the process requires it — and stay separate where integration would only add dependency.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'SAP Analytics Cloud planning and reporting consulting',
  provider: { '@type': 'Organization', name: 'Radixa Technologies' },
  description:
    'SAC planning, forecasting, financial planning, management reporting, architecture, implementation and optimisation for finance teams.',
  areaServed: ['GB', 'EU', 'Middle East'],
};
---

<Base
  title="SAP Analytics Cloud Planning & Reporting | Radixa"
  description="SAC planning, forecasting, financial planning, management reporting, architecture, implementation and optimisation for finance teams."
  schema={[serviceSchema]}
>
  <Hero
    eyebrow="Planning & reporting"
    title="SAP Analytics Cloud for Finance Planning and Reporting."
    lede="We design, implement and optimise SAP Analytics Cloud for budgeting, forecasting, financial planning and management reporting. Capability is rarely the constraint — what separates a solution finance relies on from one it works around is model design, architecture and process."
  >
    <div class="btn-group">
      <a class="btn btn-primary" href={CAP}>Discuss your SAC requirements</a>
      <a class="btn btn-secondary" href="#engagements">See engagements and durations</a>
    </div>
  </Hero>

  <!-- In-page navigation (§14.4) -->
  <nav class="subnav" aria-label="On this page">
    <div class="wrap">
      <a href="#use-cases">What finance uses it for</a>
      <a href="#architecture">Where SAC fits</a>
      <a href="#edge-cases">Planning edge cases</a>
      <a href="#engagements">Engagements</a>
      <a href="#bpc">BPC to SAC</a>
    </div>
  </nav>

  <!-- Sound familiar -->
  <section class="bg-alt">
    <div class="wrap">
      <div class="narrow">
        <p class="eyebrow">Sound familiar?</p>
        <h2>What we usually hear first.</h2>
        <ul class="checklist mt-m">
          {challenges.map((c) => <li>{c}</li>)}
        </ul>
        <p class="mt-m" style="color:var(--grey-500);max-width:70ch">
          Each of these is a symptom rather than a diagnosis, and they rarely have the cause people
          assume. That is why most of our SAC work starts with an assessment or a health check
          rather than a build.
        </p>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section id="use-cases">
    <div class="wrap">
      <p class="eyebrow">What finance uses it for</p>
      <h2>Six things worth building SAC around.</h2>
      <p class="lede mt-s">
        Grouped by what finance is trying to do rather than by product feature. The objective is a
        model that explains the business — not a spreadsheet reproduced at enterprise scale.
      </p>
      <div class="grid grid-3 mt-l">
        {
          useCases.map((u) => (
            <article class="card">
              <h3 style="font-size:1.05rem">{u.t}</h3>
              <p>{u.b}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="bg-navy on-navy" id="architecture">
    <div class="wrap">
      <div style="max-width:900px">
        <p class="eyebrow">Where SAC fits</p>
        <h2>Four questions that decide how well SAC ages.</h2>
        <p class="lede mt-s">
          These get answered either deliberately at the start, or accidentally during the build. The
          first is considerably cheaper.
        </p>
      </div>
      <div class="grid mt-l" style="grid-template-columns:repeat(auto-fit,minmax(420px,1fr))">
        {
          architecture.map((a) => (
            <article class="card" style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.16)">
              <h3 style="color:#fff">{a.q}</h3>
              <p style="color:rgba(255,255,255,0.76)">{a.a}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Edge cases -->
  <section id="edge-cases">
    <div class="wrap">
      <p class="eyebrow">Planning edge cases</p>
      <h2>A planning model is tested by these, not by the base case.</h2>
      <p class="lede mt-s">
        Every planning solution handles a clean annual budget. These are the ten situations that
        decide whether it is still trusted in year three.
      </p>
      <div class="rows mt-l">
        {
          edgeCases.map((e) => (
            <div class="row-item">
              <h3>{e.t}</h3>
              <p>{e.b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Model design -->
  <section class="bg-alt">
    <div class="wrap">
      <div class="narrow">
        <p class="eyebrow">Model design</p>
        <h2>The decisions that determine performance and maintainability.</h2>
        <ul class="checklist mt-m cols-2">
          {modelDesign.map((m) => <li>{m}</li>)}
        </ul>
        <div class="prose mt-l">
          <p>
            Data actions and multi-actions automate the repetitive parts of a planning cycle —
            seeding versions, carrying assumptions forward, calculating drivers, running allocations,
            translating currency. Used well they remove work. Used carelessly they become the part of
            the solution only their author can maintain, which is the specific outcome we design
            against.
          </p>
          <p>
            Automation should simplify the process while keeping the calculation auditable. Where
            finance genuinely works best in Excel, SAC's Microsoft Office integration can carry
            planning input and write-back rather than forcing everything into the browser.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Engagements -->
  <section id="engagements">
    <div class="wrap">
      <p class="eyebrow">Typical engagements</p>
      <h2>Scoped to the decision in front of you.</h2>
      <div class="table-scroll mt-l">
        <table>
          <caption class="visually-hidden">SAC engagement options, durations and deliverables</caption>
          <thead>
            <tr>
              <th scope="col">Engagement</th>
              <th scope="col">Typical duration</th>
              <th scope="col">Primary deliverables</th>
            </tr>
          </thead>
          <tbody>
            {
              engagements.map((e) => (
                <tr>
                  <th scope="row">{e.href ? <a href={e.href}>{e.name}</a> : e.name}</th>
                  <td>{e.duration}</td>
                  <td>{e.deliverables}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-m" style="font-size:0.875rem;color:var(--grey-500);max-width:70ch">
        Durations are indicative and depend on the number of planning models and processes in scope,
        how many contributors are involved, and the availability of your finance and IT stakeholders.
      </p>
    </div>
  </section>

  <!-- BPC to SAC -->
  <section class="bg-alt" id="bpc">
    <div class="wrap">
      <div class="narrow">
        <p class="eyebrow">BPC to SAC</p>
        <h2>Rebuilding your BPC model in SAC is usually the wrong starting point.</h2>
        <div class="prose mt-m">
          <p>
            Organisations leaving BPC often assume the existing planning models should simply be
            recreated. That reproduces years of accumulated complexity inside a new platform and
            inherits every workaround built around limitations that no longer exist.
          </p>
          <p>
            The useful exercise is to decompose what BPC actually does for you, separate genuine
            requirements from inherited habit, and then decide where each capability belongs —
            including the possibility that SAC is not the right destination for some of it.
          </p>
        </div>
      </div>
      <div class="table-scroll mt-l">
        <table>
          <caption class="visually-hidden">Indicative mapping of BPC capabilities to successor platforms</caption>
          <thead>
            <tr><th scope="col">BPC capability</th><th scope="col">Typical successor</th></tr>
          </thead>
          <tbody>
            {bpcMapping.map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="mt-m" style="font-size:0.875rem;color:var(--grey-500);max-width:70ch">
        Indicative only. The right answer depends on your requirements, and working it out is the
        substance of the <a href="/services/bpc-modernisation-assessment/">BPC Modernisation &amp; Platform Assessment</a>.
      </p>
    </div>
  </section>

  <!-- Approach -->
  <section>
    <div class="wrap">
      <p class="eyebrow">How we approach SAC</p>
      <h2>Six things you can hold us to.</h2>
      <div class="grid grid-3 mt-l">
        {
          approach.map((a) => (
            <article class="card">
              <h3 style="font-size:1.05rem">{a.title}</h3>
              <p>{a.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="bg-alt tight">
    <div class="wrap">
      <div class="narrow">
        <p class="eyebrow">Related</p>
        <h2>Where this sits.</h2>
        <ul class="checklist mt-m">
          <li><a href="/services/sac-planning-assessment/">SAC Planning Assessment</a> — deciding whether SAC fits, and what the target should be</li>
          <li><a href="/services/sac-health-check/">SAC Health Check</a> — for a solution already live that finance has started working around</li>
          <li><a href="/services/finance-data-reporting-architecture/">Finance Data &amp; Reporting Architecture</a> — where SAC sits relative to everything else</li>
          <li><a href="/training/">Training</a> — enabling the team that will operate it</li>
          <li><a href="/about/">About Radixa</a> — how we work, and the experience behind the advice</li>
        </ul>
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Next step"
    title="Describe the planning process, not the platform."
    body="How many contributors, how many cycles, where the spreadsheets sit and what makes the current process painful. That is enough for us to say which engagement fits — or whether SAC is the right answer at all."
    primaryLabel="Discuss your SAC requirements"
    primaryHref={CAP}
    secondaryLabel="See all capabilities"
    secondaryHref="/services/"
  />
</Base>
