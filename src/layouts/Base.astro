---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site, defaultMeta } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Set true on legal/utility pages that shouldn't appear in search results. */
  noindex?: boolean;
  /** Extra JSON-LD objects to inject. */
  schema?: Record<string, unknown>[];
}

const {
  title = defaultMeta.title,
  description = defaultMeta.description,
  noindex = false,
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og-default.png', site.url).href;

// --- Breadcrumbs, derived from the URL (§12.3) ---
const segments = Astro.url.pathname.split('/').filter(Boolean);
const labels: Record<string, string> = {
  services: 'What We Do',
  'sap-group-reporting': 'SAP S/4HANA Group Reporting',
  'bpc-modernisation-assessment': 'BPC Modernisation & Platform Assessment',
  'sap-analytics-cloud': 'SAP Analytics Cloud',
  'last-mile-reporting': 'Last Mile Reporting',
  'consolidation-design-architecture': 'Consolidation Design & Architecture',
  'group-reporting-health-check': 'Group Reporting Health Check',
  'sac-planning-assessment': 'SAC Planning Assessment',
  'sac-health-check': 'SAC Health Check',
  'finance-data-reporting-architecture': 'Finance Data & Reporting Architecture',
  'solution-architecture-design-authority': 'Solution Architecture & Design Authority',
  'programme-assurance-optimisation': 'Programme Assurance & Optimisation',
  training: 'Training',
  'tailored-client-training': 'Tailored Client Training',
  about: 'About',
  contact: 'Contact',
  privacy: 'Privacy notice',
  cookies: 'Cookie policy',
  terms: 'Terms of use',
};
const crumbs = segments.map((seg, i) => ({
  label: labels[seg] ?? seg.replace(/-/g, ' '),
  href: '/' + segments.slice(0, i + 1).join('/') + '/',
}));

const organisationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  slogan: site.tagline,
  description: defaultMeta.description,
  email: site.email,
  ...(site.linkedin ? { sameAs: [site.linkedin] } : {}),
  areaServed: ['GB', 'EU', 'Middle East'],
};

const breadcrumbSchema =
  crumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
          ...crumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name: c.label,
            item: new URL(c.href, site.url).href,
          })),
        ],
      }
    : null;

const allSchema = [organisationSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0A2540" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />

    {
      crumbs.length > 0 && (
        <div class="breadcrumbs">
          <div class="wrap">
            <nav aria-label="Breadcrumb">
              <ol>
                <li><a href="/">Home</a></li>
                {crumbs.map((c, i) => (
                  <li>
                    {i === crumbs.length - 1 ? (
                      <span aria-current="page">{c.label}</span>
                    ) : (
                      <a href={c.href}>{c.label}</a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        </div>
      )
    }

    <main id="main">
      <slot />
    </main>

    <Footer />
    <CookieBanner />
  </body>
</html>
