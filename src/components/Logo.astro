---
/**
 * Radixa logo.
 *
 * Vector files live in  public/brand/ :
 *   logo-notagline.svg           header / light backgrounds
 *   logo-reversed.svg            footer / navy backgrounds (includes tagline)
 *   logo-reversed-notagline.svg  navy backgrounds, tagline omitted
 *   logo.svg                     full light lockup with tagline
 *   mark.svg                     symbol only
 *
 * SVG stays sharp at any size and on any screen, and the header logo is about
 * 21 KB over the wire against 163 KB for the PNG it replaced. The .png versions
 * are kept alongside for anywhere that cannot take vector (email signatures,
 * older Office templates) — see the brand kit for the full set.
 */
interface Props {
  reversed?: boolean;
  /** Include the "Rooted in Better Decisions." tagline lock-up. */
  tagline?: boolean;
  height?: number;
  class?: string;
  /** Set true when the logo is the largest element above the fold. */
  eager?: boolean;
}
const {
  reversed = false,
  tagline = false,
  height = 34,
  class: className = '',
  eager = false,
} = Astro.props;

const file = reversed
  ? tagline
    ? '/brand/logo-reversed.svg'
    : '/brand/logo-reversed-notagline.svg'
  : tagline
    ? '/brand/logo.svg'
    : '/brand/logo-notagline.svg';

// Intrinsic sizes, used to reserve space and avoid layout shift (CLS).
// Both lockups are drawn on the same 787 x 227 / 787 x 180 canvas.
const ratio = tagline ? 787 / 227 : 787 / 180;
const width = Math.round(height * ratio);
---

<img
  src={file}
  alt="Radixa Technologies"
  width={width}
  height={height}
  class={className}
  style={`height:${height}px;width:auto`}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
